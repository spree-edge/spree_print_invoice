<%= search_form_for [:admin, @search],
  class: "filter-wrap",
  data: {
    controller: "filters reveal",
    reveal_hidden_class: "d-none",
    filters_url_value: request.url
  } do |f| %>
  <%#= hidden_field_tag :frame_name, frame_name if frame_name.present? %>

  <div class="d-flex flex-column flex-lg-row gap-2">
    <%= render 'spree/admin/shared/filters_search_bar', param: :multi_search %>

    <div class="d-flex align-items-center justify-content-between">
      <%= render 'spree/admin/shared/filters_button' %>
    </div>
  </div>
  <div data-reveal-target="item" class="d-none" id="table-filter">
    <%= f.hidden_field :template_type_eq, value: params[:q][:template_type_eq] %>
    
    <div class="row">
      <div class="col-12 col-lg-6">
        <div class="form-group">
          <%= label_tag :q_number_cont, Spree.t(:printable_number, number: '') %>
          <%= f.text_field :number_cont, class: 'form-control js-quick-search-target' %>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="form-group">
              <%= label_tag :q_firstname_start, Spree.t(:first_name_begins_with) %>
              <%= f.text_field :firstname_start, class: 'form-control' %>
         </div>
      </div>
    </div>
    <div class="row">
      <div class="col-12 col-lg-6">
        <div class="form-group">
          <%= label_tag :q_lastname_start, Spree.t(:last_name_begins_with) %>
          <%= f.text_field :lastname_start, class: 'form-control' %>
        </div>
      </div>

      <div class="col-12 col-lg-6">
        <div class="form-group">
          <%= label_tag :q_email_cont, Spree.t(:email) %>
          <%= f.text_field :email_cont, class: 'form-control js-filterable' %>
        </div>
      </div>
    </div>

    <%= render 'spree/admin/shared/filter_submit' %>
  </div>

  <%= render "spree/admin/shared/filter_badge_template" %>

  <div data-filters-target="badgesContainer" class="filter-badges-container"></div>
<% end %>
