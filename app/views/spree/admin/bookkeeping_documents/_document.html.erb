<tr data-hook="admin_printables_index_rows" class="<%= cycle('odd', 'even') %>">
  <td><%= document.created_at.to_date %></td>
  <td><%= Spree.t(document.document_type, scope: [:print_invoice]) %></td>
  <td><%= document.number %></td>
  <td><%= document.firstname %></td>
  <td><%= document.lastname %></td>
  <td><%= document.email %></td>
  <td><%= document.display_total.to_html %></td>
  <td class='actions actions-1' data-hook="admin_orders_index_row_actions">
    <%= link_to_with_icon "file", "", admin_bookkeeping_document_path(document, format: :pdf), title: "show_bookkeeping_document_#{document.id}", no_text: true %>
  </td>
</tr>
